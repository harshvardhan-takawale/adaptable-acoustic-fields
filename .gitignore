# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/
.ruff_cache/
.mypy_cache/

# Reference material kept locally, not in repo
project_files/

# SLURM outputs
slurm-*.out
/logs/*
!/logs/.gitkeep
!/logs/slurm/
/logs/slurm/*
!/logs/slurm/.gitkeep

# Training artifacts
/ckpts/
/checkpoints/
/runs/
/tb_logs/
/wandb/

# Data (top-level dataset dir; keep aaf/data/ as source)
/data/
*.h5
*.hdf5
*.npz
*.npy
*.wav

# Editor / OS
.vscode/
.idea/
.DS_Store
*.swp

# Local env
.env
*.local.yml

# Claude harness state
.claude/

# Generated reports — keep markdown and PDFs but not raster images / SVG.
# (PDFs are small and useful for reviewers.)
/outputs/**/*.png
/outputs/**/*.svg
/outputs/**/*.jpg
/outputs/**/*.jpeg

# Allow chunk-2 single-room overfit figures (small, useful for reviewers).
!/outputs/single_room/**/*.png

# Training artifacts under outputs/single_room/L*/
/outputs/single_room/**/*.pt
/outputs/single_room/**/tb/
/outputs/single_room/**/*.tfevents.*

# Allow chunk-3 multi-room + zero-shot + latent-probe figures (small, useful).
!/outputs/multi_room/**/*.png
!/outputs/meeting_assets/**/*.png
!/outputs/meeting_assets/**/*.wav
!/outputs/spatial_nodes_check/**/*.png
!/outputs/inner_loop_experiments/**/*.png

# Training artifacts under outputs/multi_room/
/outputs/multi_room/**/*.pt
/outputs/multi_room/**/tb/
/outputs/multi_room/**/*.tfevents.*
/outputs/multi_room/**/z_star.pt
/outputs/multi_room/**/loss_curve.json

# Allow Phase-2 (3D) single-room figures and summary
!/outputs/single_room_3d/**/*.png
!/outputs/single_room_3d/**/SUMMARY.md
!/outputs/budget_check_3d/REPORT.md
!/outputs/memory_check_3d/REPORT.md

# Training artifacts under outputs/single_room_3d/
/outputs/single_room_3d/**/*.pt
/outputs/single_room_3d/**/tb/
/outputs/single_room_3d/**/*.tfevents.*

# Allow Phase-2 (3D) multi-room outputs (P2-2)
!/outputs/multi_room_3d/**/*.png
!/outputs/multi_room_3d/**/SUMMARY.md
!/outputs/multi_room_3d/**/*.json
!/outputs/memory_check_multi_3d/REPORT.md
!/outputs/memory_check_multi_3d/result.json

# Training artifacts under outputs/multi_room_3d/
/outputs/multi_room_3d/**/*.pt
/outputs/multi_room_3d/**/tb/
/outputs/multi_room_3d/**/*.tfevents.*

# P2-2.5 diagnostic: allow figures + DIAGNOSIS.md + train_meta + scalars
!/outputs/diag_p2_2_5/**/*.png
!/outputs/diag_p2_2_5/**/*.md
!/outputs/diag_p2_2_5/**/*.json
# Ignore checkpoints + tb logs
/outputs/diag_p2_2_5/**/*.pt
/outputs/diag_p2_2_5/**/tb/
/outputs/diag_p2_2_5/**/*.tfevents.*

# Phase-3 P3-1: keep reports/json + edit figures, drop heavy ckpts/tb/tfevents
!/outputs/p3_1/**/*.png
!/outputs/p3_1/**/*.md
!/outputs/p3_1/**/*.json
/outputs/p3_1/**/*.pt
/outputs/p3_1/**/tb/
/outputs/p3_1/**/*.tfevents.*

# --- 2026-08 maintenance: keep reports + source, drop heavy & per-room/per-run artifacts ---
# Checkpoints & TensorBoard event logs anywhere under outputs (consolidates the per-dir rules above).
/outputs/**/*.pt
/outputs/**/tb/
/outputs/**/*.tfevents.*
# Coverage-curve (P2-4) per-room lookup / zero-shot dumps — headline is in SCALING.md / CONFOUND_CHECK.md.
/outputs/coverage_curve/**/lookup/**
/outputs/coverage_curve/**/lookup_summary.json
/outputs/coverage_curve/**/zero_shot/**
# multi_room_3d (P2-2/2-3) per-room zero-shot dumps + per-run metadata — headline is in the SUMMARY.md files.
/outputs/multi_room_3d/**/zero_shot/**
/outputs/multi_room_3d/**/scalars.json
/outputs/multi_room_3d/**/train_meta.json
# Superseded zero-shot experiment scratch dirs (any already-committed reports within them stay tracked).
/outputs/runC_zeroshot_initonly/**
/outputs/runC_zeroshot_probe/**
/outputs/runC_zeroshot_probe_fix/**
/outputs/p3_zeroshot_anchored/**
# P3-1 training-run dirs (checkpoints / scalars / tb) — convergence is summarized in the P3-1 reports.
/outputs/p3_1/arm_L/**
/outputs/p3_1/arm_G/**
/outputs/p3_1/arm_Gplus/**
/outputs/p3_1/arm_Gplus_fast/**

# Phase-3 P3-2 (2D material editing): keep reports/json + figures, drop the training run.
!/outputs/p3_2/**/*.png
!/outputs/p3_2/**/*.md
!/outputs/p3_2/**/*.json
/outputs/p3_2/model/**
# Per-config eval dump (~2 MB, one record per room incl. per-mode cells) — regenerable by
# re-running scripts/slurm/p3_2_eval.sh; summary.json is the tracked headline (D44 policy).
/outputs/p3_2/eval/per_config.json
# Layout-check output of `make_p3_2_figures.py --synthetic`: every number in it is FABRICATED.
# The whitelist above would otherwise make these committable, and a watermark is not a
# sufficient guard for that — keep them structurally unpushable.
/outputs/p3_2/meeting_assets_SYNTHETIC/**
# Field dump for figure E (~16 MB of complex spectra) — regenerable via
# scripts/slurm/p3_2_dump_fields.sh; already covered by *.npz, pinned here for clarity.
/outputs/p3_2/meeting_assets/fields.npz

# P3-2 dataset (regenerable from configs + scripts/build_2d_mat_dataset.py)
/data/track_c_2d/
